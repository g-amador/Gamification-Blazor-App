<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Only nuget.org is used by this repository.
         Keep this local config instead of relying on the machine-level
         NuGet.Config so `dotnet ef` and CI never depend on private feeds. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
