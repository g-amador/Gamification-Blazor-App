            ],
            "url": {
              "raw": "https://localhost:5001/badges/1",
              "protocol": "https",
              "host": ["localhost"],
              "port": "5001",
              "path": ["badges", "1"]
            },
            "description": "Gets the information of the given badge, including categoryId when set.\n\n**Response**\n\n- 200\n\nBODY\n\n``` json\n{\n  \"id\": 0,\n  \"name\": \"\",\n  \"description\": \"\",\n  \"icon\": \"\",\n  \"categoryId\": 0\n}\n```"
          },
          "response": []
        },
        {
          "name": "Update badge information",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "apiKey", "value": "GamificationDemo", "type": "text" },
              { "key": "apiPassword", "value": "password", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"First Login\",\n    \"description\": \"Awarded when the player logs in for the first time\",\n    \"icon\": \"data:image/png;base64,...\",\n    \"categoryId\": 1\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "https://localhost:5001/badges/1",
              "protocol": "https",
              "host": ["localhost"],
              "port": "5001",
              "path": ["badges", "1"]
            },
            "description": "Updates a badge: name, description, icon and categoryId.\n\n**Response**\n\n- 200"
          },
          "response": []
        },
        {
          "name": "Delete a badge",
          "request": {
            "method": "DELETE",
            "header": [
