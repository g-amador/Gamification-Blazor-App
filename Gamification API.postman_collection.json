              { "key": "apiPassword", "value": "password", "type": "text" }
            ],
            "url": {
              "raw": "https://localhost:5001/badges/1",
              "protocol": "https",
              "host": ["localhost"],
              "port": "5001",
              "path": ["badges", "1"]
            },
            "description": "Deletes a badge. All links to this badge by rules are set to null.\n\n**Response**\n\n- 200"
          },
          "response": []
        }
      ]
    },
