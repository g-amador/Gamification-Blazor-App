              "raw": "{\n    \"name\": \"First Login\",\n    \"description\": \"Awarded when the player logs in for the first time\",\n    \"icon\": \"data:image/png;base64,...\",\n    \"categoryId\": 1\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "https://localhost:5001/badges",
              "protocol": "https",
              "host": ["localhost"],
              "port": "5001",
              "path": ["badges"]
            },
            "description": "Adds a new badge with the path to an icon representing the badge. categoryId is optional.\n\n**Response**\n\n- 201\n\nBODY\n\n``` json\n{\n  \"status\": \"created\",\n  \"url\": \"/badges/1\",\n  \"id\": 1\n}\n```"
          },
          "response": []
        },
        {
          "name": "Get badge details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apiKey", "value": "GamificationDemo", "type": "text" },
